# 天罡 WAF 环境配置文件
# 复制此文件为 .env 并根据实际情况修改

# ==========================================
# 应用基础配置
# ==========================================
APP_NAME=Tiangang-WAF
APP_ENV=production
APP_DEBUG=false

# ==========================================
# 服务端口配置
# ==========================================
# WAF 代理端口（接收被保护的请求）
PROXY_PORT=8787

# 管理后台端口
ADMIN_PORT=8989

# ==========================================
# Nginx 集成配置（前置 Nginx 模式）
# ==========================================
# 后置 Nginx 地址（用于配置重载）
NGINX_BACKEND_HOST=127.0.0.1
NGINX_BACKEND_PORT=8788

# WAF API 地址（供 Nginx Lua 脚本读取配置）
WAF_API_HOST=127.0.0.1:8989

# ==========================================
# 数据库配置（如果使用数据库）
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiangang_waf
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# Redis 配置（用于缓存和限流）
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info
LOG_PATH=runtime/logs

# ==========================================
# WAF 核心配置
# ==========================================
# 是否启用 WAF 防护
WAF_ENABLED=true

# 默认动作（block/log/pass）
WAF_DEFAULT_ACTION=block

# 攻击检测灵敏度（low/medium/high）
WAF_SENSITIVITY=medium

# ==========================================
# 性能配置
# ==========================================
# Worker 进程数
WORKER_PROCESSES=4

# 每个 Worker 的连接数
WORKER_CONNECTIONS=1024

# ==========================================
# 安全配置
# ==========================================
# 管理后台密钥
ADMIN_SECRET_KEY=change_this_to_random_string

# CSRF Token 密钥
CSRF_SECRET=change_this_to_random_string

# 会话过期时间（秒）
SESSION_LIFETIME=7200

# ==========================================
# Docker 网络配置
# ==========================================
NGINX_IP=172.100.0.2
WAF_IP=172.100.0.3
